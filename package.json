{
  "name": "project-palacio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @project-palacio/duel-server --filter @project-palacio/duel-web run dev",
    "duel": "pnpm run dev",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "build": "pnpm --filter @project-palacio/duel-web build",
    "balance": "pnpm --filter @project-palacio/duel-server balance",
    "docs:cards": "pnpm --filter @project-palacio/duel-server docs:cards",
    "android:run": "pnpm --filter @project-palacio/duel-web android:run",
    "android:sync": "pnpm --filter @project-palacio/duel-web android:sync",
    "android:open": "pnpm --filter @project-palacio/duel-web android:open",
    "android:setup": "pnpm --filter @project-palacio/duel-web android:setup",
    "android:bundle": "pnpm --filter @project-palacio/duel-web android:bundle"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
